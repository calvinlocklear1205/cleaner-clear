# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API → service_role secret. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passcode for /judge (and ?key= for /wall). Use something longer than a PIN.
JUDGE_PASSCODE=
# Safety lead's mobile, E.164 format (e.g. +13035551234). Used in the sms: hazard link.
SAFETY_LEAD_PHONE=
# Kill switch. Set to false to close submissions. On Vercel, env changes take effect on the next deploy
# (or flip `submissionsOpen` in config/event.ts and push).
SUBMISSIONS_OPEN=true
